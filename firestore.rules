rules_version = '2';
// Pixlynote Firestore security rules (phase 2 security, branch grokbot/phase2-security).
// NOT DEPLOYED. Deploy only after Bradley's Go, in the order in tools/phase2/SHIP.md:
// worker update (Plus writes), client ship, content + close-friends migration, then these rules.
//
// Identity model
// - Every real account has one Firebase Auth user. users/{username}.uid is that user's uid.
// - uidIndex/{uid} = { username } maps the signed-in user back to the account name (written by the owner).
// - Signed-out visitors have NO Auth session (Anonymous sign-in is off in Firebase): they can read public content
//   and raise a public post's or note's view count by exactly one. Nothing else.
// - users/{u}.delegateUids lists the uids the owner granted Privileged Access (passwordless, read-only view).
// - @pixlynote is the admin account: its uid may read and fix anything (admin tools keep working).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function realUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function userPath(u) { return /databases/$(database)/documents/users/$(u); }
    function uidIndexPath() { return /databases/$(database)/documents/uidIndex/$(request.auth.uid); }
    function ownsUser(u) {
      return realUser() && exists(userPath(u)) && get(userPath(u)).data.get('uid', '') == request.auth.uid;
    }
    function isDelegate(u) {
      return realUser() && exists(userPath(u)) && request.auth.uid in get(userPath(u)).data.get('delegateUids', []);
    }
    function canActAs(u) { return ownsUser(u) || isDelegate(u); }
    // Privileged Access is read-only: delegates may view as the owner, but only the owner may write.
    function canWriteAs(u) { return ownsUser(u); }
    function isAdmin() { return ownsUser('pixlynote'); }
    // Bradley's decision (open, default NO): may @pixlynote read private accounts' posts and connections lists?
    // Admin moderation (delete, verification review, account deletion, support data) works either way.
    // To turn the bypass on, return isAdmin() here.
    function adminSeesPrivate() { return false; }
    // The account name of the signed-in user ('__none__' when unknown).
    function myName() {
      return realUser() && exists(uidIndexPath()) ? get(uidIndexPath()).data.get('username', '__none__') : '__none__';
    }
    // Written positively on purpose: for a query whose author is unknown, exists() is false, so this is false.
    function isPublicAccount(u) { return exists(userPath(u)) && get(userPath(u)).data.get('isPrivate', false) == false; }
    // The signed-in user is an approved connection of `owner` (owner-created followers edge).
    function approvedBy(owner) {
      return realUser() && exists(/databases/$(database)/documents/users/$(owner)/followers/$(myName()));
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // A view counter that goes up by exactly one (anyone, signed in or not).
    function plusOneView() {
      return request.resource.data.get('views', 0) == (resource == null ? 0 : resource.data.get('views', 0)) + 1;
    }
    // Plus / Verified / Business Plus may be set only by the Worker (service account, bypasses rules)
    // or by @pixlynote admin tools. Account owners cannot set these on themselves.
    function privilegeFields() {
      return ['isPlus', 'isVerified', 'isBusinessPlus', 'subscriptionStatus',
              'stripeCancelAtPeriodEnd', 'stripeCurrentPeriodEnd', 'stripeSessionId', 'stripeBusinessSessionId',
              'canceledAt', 'plusCancelScheduledAt', 'verifiedUpdatedAt', 'businessPlusUpdatedAt',
              'businessPlusCanceledAt', 'plusSince', 'plusExpiresAt'];
    }
    function noPrivilegeGrant() {
      return request.resource.data.get('isPlus', false) != true
          && request.resource.data.get('isVerified', false) != true
          && request.resource.data.get('isBusinessPlus', false) != true;
    }
    function privilegeUnchanged() {
      return request.resource.data.get('isPlus', resource.data.get('isPlus', false)) == resource.data.get('isPlus', false)
          && request.resource.data.get('isVerified', resource.data.get('isVerified', false)) == resource.data.get('isVerified', false)
          && request.resource.data.get('isBusinessPlus', resource.data.get('isBusinessPlus', false)) == resource.data.get('isBusinessPlus', false)
          && request.resource.data.get('subscriptionStatus', resource.data.get('subscriptionStatus', '')) == resource.data.get('subscriptionStatus', '');
    }
    // Showcase (house-run) accounts: only @pixlynote admin tools may mark an account as Showcase.
    function showcaseClaimed() {
      return request.resource.data.get('isShowcase', false) == true
          || request.resource.data.get('accountType', '') == 'showcase';
    }
    // Owners may keep or drop the Showcase marker, never add it.
    function showcaseNotAdded() {
      return (request.resource.data.get('isShowcase', false) != true || resource.data.get('isShowcase', false) == true)
          && (request.resource.data.get('accountType', '') != 'showcase' || resource.data.get('accountType', '') == 'showcase');
    }
    // Promote Post fields are written only by the Worker (service account, after a paid Stripe Checkout) or admin.
    function promoteFields() {
      return ['isPromoted', 'promotedUntil', 'targetImpressions', 'promotedImpressionsCount', 'ctaLabel', 'ctaUrl',
              'promotedAt', 'promotionTier', 'promotionAmount', 'promotionDurationHours', 'promoteSessionId',
              'promotionEndedAt'];
    }
    // Notes, stories, highlights and the following list live in users/{u}/content/profile, not on the public doc.
    function contentFields() {
      return ['notes', 'story', 'userStories', 'highlights', 'following'];
    }
    function usernameOf(entry) {
      return entry is map ? entry.get('username', '') : (entry is string ? entry : '');
    }
    // Cross-user writes: only the minimal, checked changes the app needs.
    function notificationsAppend() {
      let before = resource.data.get('notifications', []);
      let after = request.resource.data.get('notifications', []);
      return after is list && before is list
          && after.size() == before.size() + 1
          && after.hasAll(before)
          && after[0] is map
          && after[0].get('fromUser', '') == myName();
    }
    // ---- Likes: one like per person ----
    // posts/{id}.likedBy may change by exactly one entry per write, and that entry is the signed-in account's own
    // name: add yourself once, or remove yourself. Nobody can add a second copy of themselves, add or remove another
    // person, or replace the list.
    function likeAdds(before, after, me) {
      return before is list && after is list && me != '__none__'
          && after.size() == before.size() + 1
          && after.hasAll(before)
          && !before.hasAny([me])
          && after[after.size() - 1] == me;
    }
    function likeRemoves(before, after, me) {
      return before is list && after is list && me != '__none__'
          && before.size() == after.size() + 1
          && before.hasAll(after)
          && before.hasAny([me])
          && !after.hasAny([me]);
    }
    function likeListStep(before, after) {
      return after == before || likeAdds(before, after, myName()) || likeRemoves(before, after, myName());
    }
    // posts/{id}.likedBy: arrayUnion(me) / arrayRemove(me) and nothing else in the same write.
    function postLikedByStep() {
      return changed().hasOnly(['likedBy'])
          && likeListStep(resource.data.get('likedBy', []), request.resource.data.get('likedBy', []));
    }
    // users/{owner}.storyLikes: one write may touch at most ONE story's list (no wiping or rewriting many at once).
    // Firestore rules cannot read a map key out of a diff, so the "only my own name changes" check that posts get
    // (postLikedByStep) cannot be applied to story lists in this data shape. See tests/rules/like-once.test.js.
    function storyLikesStep() {
      let before = resource.data.get('storyLikes', {});
      let after = request.resource.data.get('storyLikes', {});
      return after is map && before is map && after.diff(before).affectedKeys().size() <= 1;
    }
    function onlySelfPrivilegedAccounts() {
      let before = resource.data.get('privilegedAccounts', []);
      let after = request.resource.data.get('privilegedAccounts', []);
      return before is list && after is list && before.hasAll(after)
          && before.size() >= after.size()
          && !after.hasAny([myName()]);
    }
    // The only entries that differ are ones for this signed-in account (accept / decline).
    function onlySelfGrantedEntry() {
      let before = resource.data.get('privilegedAccessGranted', []);
      let after = request.resource.data.get('privilegedAccessGranted', []);
      return before is list && after is list
          && before.size() - after.size() <= 1
          && after.size() - before.size() <= 1;
    }
    // `username` is passed in: a function declared at this level cannot see the {username} of the match below it.
    // (Before this fix the storyComments and storyLikes branches always errored and were denied.)
    function crossUserUpdate(username) {
      return realUser() && !changed().hasAny(privilegeFields()) && !changed().hasAny(privateFields())
          && !changed().hasAny(contentFields())
          && (
            (changed().hasOnly(['notifications', 'lastUpdated']) && notificationsAppend())
            || (changed().hasOnly(['storyComments', 'lastUpdated']) && (isPublicAccount(username) || approvedBy(username) || canWriteAs(username)))
            || (changed().hasOnly(['storyLikes', 'lastUpdated']) && (isPublicAccount(username) || approvedBy(username) || canWriteAs(username)) && storyLikesStep())
            || (changed().hasOnly(['privilegedAccessGranted', 'lastUpdated']) && onlySelfGrantedEntry())
            || (changed().hasOnly(['businessAssociates', 'lastUpdated']) && myName() != '__none__')
            || (changed().hasOnly(['associatedBusiness', 'associatedBusinessUsername', 'associatedBusinessFullName', 'associatedBusinessAvatar', 'lastUpdated']) && myName() != '__none__')
          );
    }
    // Contact, credential, DM and session fields live in users/{u}/private/account, never on the public doc.
    function privateFields() {
      return ['email', 'phone', 'dms', 'lastDmUpdated', 'loginActivityLog', 'otherSessions', 'sessionRevokedAt',
              'stripeCustomerId', 'stripeSubscriptionId', 'stripeBusinessSubscriptionId', 'verificationEmail',
              'accountCenterAccounts', 'removedAccountCenterUsernames', 'passwordHash', 'password'];
    }

    match /users/{username} {
      // Public header (name, avatar, bio, isPrivate, counts) so "This account is private" can render.
      allow read: if true;
      allow create: if (realUser()
                        && request.resource.data.get('uid', '') == request.auth.uid
                        && !request.resource.data.keys().hasAny(privateFields())
                        && !request.resource.data.keys().hasAny(contentFields())
                        && request.resource.data.get('isAdmin', false) == false
                        && noPrivilegeGrant()
                        && !showcaseClaimed())
                    // A notification to an account that has no doc yet (must be from this user).
                    || (realUser() && request.resource.data.keys().hasOnly(['notifications', 'lastUpdated'])
                        && request.resource.data.get('notifications', []) is list
                        && request.resource.data.notifications.size() == 1
                        && request.resource.data.notifications[0] is map
                        && request.resource.data.notifications[0].get('fromUser', '') == myName()
                        && noPrivilegeGrant())
                    || isAdmin();
      allow update: if (canWriteAs(username)
                        && request.resource.data.get('uid', '') == resource.data.get('uid', '')
                        && (ownsUser(username) || request.resource.data.get('delegateUids', []) == resource.data.get('delegateUids', []))
                        && !changed().hasAny(privateFields())
                        && !changed().hasAny(privilegeFields())
                        && privilegeUnchanged()
                        && showcaseNotAdded()
                        && !changed().hasAny(contentFields()))
                    // Sign-up on a username that only had a placeholder doc (no uid, never had a password).
                    || (realUser()
                        && resource.data.get('uid', '') == ''
                        && !('passwordHash' in resource.data)
                        && request.resource.data.get('uid', '') == request.auth.uid
                        && noPrivilegeGrant()
                        && showcaseNotAdded()
                        && !changed().hasAny(privilegeFields()))
                    || crossUserUpdate(username)
                    || isAdmin();
      allow delete: if ownsUser(username) || isAdmin();

      // Billing History: Stripe purchase records written only by the Worker's signed Stripe webhook
      // (service account) or admin. Only the account owner can read them (not Privileged Access delegates).
      match /billing/{recordId} {
        allow read: if ownsUser(username) || isAdmin();
        allow write: if isAdmin();
      }
      match /private/{docId} {
        allow read: if canActAs(username) || isAdmin();
        allow write: if canWriteAs(username) || isAdmin();
      }
      // Notes, stories, highlights and the following list. Public accounts: anyone may read.
      // Private accounts: only the owner, a Privileged Access delegate, or an approved connection.
      match /content/{docId} {
        allow read: if isPublicAccount(username) || canActAs(username) || approvedBy(username) || adminSeesPrivate();
        allow write: if canWriteAs(username) || isAdmin();
      }

      // Connections edges. Public account: the follower writes their own edge.
      // Private account: only the owner creates an edge (that is the approval).
      match /followers/{follower} {
        allow read: if isPublicAccount(username) || canActAs(username) || approvedBy(username)
                    || myName() == follower || adminSeesPrivate();
        allow create: if (realUser() && request.resource.data.username == follower
                          && ((canWriteAs(follower) && isPublicAccount(username)) || canWriteAs(username)))
                      || isAdmin();
        allow update: if (realUser() && request.resource.data.username == follower
                          && (canWriteAs(username) || canWriteAs(follower)))
                      || isAdmin();
        allow delete: if canWriteAs(username) || canWriteAs(follower) || isAdmin();
      }

      // Connect requests to a private account.
      match /connectRequests/{requester} {
        allow read: if canActAs(username) || canActAs(requester) || isAdmin();
        allow create, update: if canWriteAs(requester) && requester != username
          && request.resource.data.username == requester
          && request.resource.data.keys().hasOnly(['username', 'fullName', 'avatar', 'requestedAt']);
        allow delete: if canWriteAs(username) || canWriteAs(requester) || isAdmin();
      }
    }

    match /posts/{postId} {
      function readablePost(d) {
        // No get() defaults here: a query that does not pin authorPrivate or author must not pass.
        return d.authorPrivate == false
          || isPublicAccount(d.author)
          || canActAs(d.author)
          || approvedBy(d.author)
          || adminSeesPrivate();
      }
      // Rules are not filters: list queries must say where('authorPrivate', '==', false),
      // or where('author', '==', X) for an account the viewer may see.
      allow read: if readablePost(resource.data);
      allow create: if realUser() && canWriteAs(request.resource.data.author)
        && (isPublicAccount(request.resource.data.author) || request.resource.data.get('authorPrivate', false) == true)
        && !request.resource.data.keys().hasAny(promoteFields());
      allow update: if (canWriteAs(resource.data.author)
                        && !changed().hasAny(promoteFields())
                        && (request.resource.data.author == resource.data.author || canWriteAs(request.resource.data.author))
                        && (isPublicAccount(resource.data.author) || request.resource.data.get('authorPrivate', false) == true))
                    || (realUser() && changed().hasOnly(['comments']) && readablePost(resource.data))
                    || (changed().hasOnly(['views']) && plusOneView() && readablePost(resource.data))
                    || (realUser() && postLikedByStep() && readablePost(resource.data))
                    || isAdmin();
      allow delete: if canWriteAs(resource.data.author) || isAdmin();
    }

    match /uidIndex/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if realUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'updatedAt'])
        && ownsUser(request.resource.data.username);
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // contactIndex/{sha256 of the normalized email or phone} = { usernames: [...] } for "already taken"
    // checks and the Worker's recipient check. Single-document gets only; nobody can list it.
    match /contactIndex/{key} {
      function onlyChanges(name) {
        let after = request.resource.data.get('usernames', []).toSet();
        let before = (resource == null ? [] : resource.data.get('usernames', [])).toSet();
        return after.difference(before).union(before.difference(after)).hasOnly([name]);
      }
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if (realUser()
                                && request.resource.data.keys().hasOnly(['usernames', 'by', 'updatedAt'])
                                && request.resource.data.usernames is list
                                && canWriteAs(request.resource.data.by)
                                && onlyChanges(request.resource.data.by))
                            || isAdmin();
      allow delete: if isAdmin();
    }

    match /accountCenters/{owner} {
      allow read: if canActAs(owner) || isAdmin();
      allow create: if canWriteAs(owner) || isAdmin();
      // Revoking Privileged Access may add yourself to someone's removedUsernames.
      allow update: if canWriteAs(owner) || isAdmin() || (realUser() && changed().hasOnly(['removedUsernames']));
      allow delete: if canWriteAs(owner) || isAdmin();
    }
    match /profileHistory/{owner} {
      allow read: if canActAs(owner) || isAdmin();
      allow write: if canWriteAs(owner) || isAdmin();
    }
    match /verificationRequests/{owner} {
      allow read: if canActAs(owner) || isAdmin();
      allow write: if canWriteAs(owner) || isAdmin();
    }
    match /closeFriends/{owner} {
      // The full list is only for the owner (and admin tools). Viewers check members/{theirName}.
      allow read: if canActAs(owner) || isAdmin();
      allow write: if canWriteAs(owner) || isAdmin();
      match /members/{member} {
        allow read: if canActAs(owner) || myName() == member || isAdmin();
        allow write: if canWriteAs(owner) || isAdmin();
      }
    }
    match /blocks/{owner} {
      allow read: if canActAs(owner) || isAdmin();
      allow write: if canWriteAs(owner) || isAdmin();
    }
    match /mutes/{owner} {
      allow read: if canActAs(owner) || isAdmin();
      allow write: if canWriteAs(owner) || isAdmin();
    }
    match /story_comments/{docId} {
      allow read: if true;
      allow create, update: if realUser();
      allow delete: if isAdmin();
    }
    // Promoted notes (notes have no document of their own). Written only by the Worker / admin.
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /noteViews/{noteId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['views']) && plusOneView();
      allow delete: if isAdmin();
    }
    match /{collection}/{document=**} {
      // Admin tools only. posts/ and users/ have their own rules above (the admin bypass of private content is
      // a separate decision: adminSeesPrivate()).
      allow read, write: if isAdmin() && !(collection in ['posts', 'users']);
    }
  }
}
